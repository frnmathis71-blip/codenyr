APP_NAME=Codenyr
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://codenyr.test
FORCE_HTTPS=true
SESSION_SECURE_COOKIE=true
CODENYR_VITRINE_DEMO_URL=http://demo-vitrine.test/demo/site-vitrine
CODENYR_LANDING_DEMO_URL=http://demo-vitrine.test/demo/landing-page

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@codenyr.fr"
MAIL_FROM_NAME="${APP_NAME}"

# Production: MAIL_MAILER=brevo, with the SMTP login and key from Brevo > SMTP & API > SMTP.
# MAIL_FROM_ADDRESS must belong to a domain verified in Brevo (SPF, DKIM and DMARC records at OVH).
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# Minimum seconds a person takes to fill a public form (0 disables the check).
CODENYR_SPAM_MIN_SECONDS=3
# Submissions allowed per IP address and per form over 10 minutes (HTTP 429 beyond).
CODENYR_SPAM_MAX_ATTEMPTS=5
# Links allowed in a message.
CODENYR_SPAM_MAX_LINKS=2
# Optional: comma-separated spam phrases replacing the default list of config/codenyr.php.
# CODENYR_SPAM_KEYWORDS="viagra,online casino,backlinks"

# Google reCAPTCHA (https://www.google.com/recaptcha/admin). See docs/anti-spam.md.
# v3 keys (score, invisible). Left empty, reCAPTCHA is off and the other protections still apply.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# v2 "checkbox" keys, shown as a fallback when the v3 score is doubtful.
RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=
# Score accepted from RECAPTCHA_THRESHOLD; checkbox challenge between the two; refused below.
RECAPTCHA_THRESHOLD=0.5
RECAPTCHA_CHALLENGE_THRESHOLD=0.3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CODENYR_EMAIL=contact@codenyr.fr
AUTH_EMAIL_VERIFICATION=false
CODENYR_LINKEDIN=
CODENYR_INSTAGRAM=

# Admin assistants: anthropic (Claude) or gemini (free tier on aistudio.google.com)
CODENYR_ASSISTANT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CODENYR_GEMINI_MODEL=gemini-flash-latest
